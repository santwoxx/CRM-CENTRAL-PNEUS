# ==========================================================================
# CRM CENTRAL PNEUS - configuracao
# Copie para `.env` e preencha. Nunca versione o .env.
# ==========================================================================

NODE_ENV=development
LOG_LEVEL=info
TZ=America/Sao_Paulo

# --- Servidor -------------------------------------------------------------
API_PORT=3333
API_HOST=0.0.0.0
# URL publica da API. Em producao precisa ser HTTPS: a Meta so entrega
# webhook em endpoint com certificado valido.
PUBLIC_API_URL=http://localhost:3333
# Origens liberadas no CORS (separadas por virgula).
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# --- Banco de dados -------------------------------------------------------
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm_dev_password
POSTGRES_DB=crm
POSTGRES_PORT=5432
DATABASE_URL=postgresql://crm:crm_dev_password@localhost:5432/crm?schema=public

# --- Redis (filas, cache, presenca, pub/sub do realtime) ------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- Seguranca ------------------------------------------------------------
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=troque-por-um-segredo-longo-e-aleatorio-access
JWT_REFRESH_SECRET=troque-por-um-segredo-longo-e-aleatorio-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Chave de 32 bytes em base64 usada para cifrar credenciais de canal no banco.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_ENCRYPTION_KEY=

# --- Armazenamento de midia ----------------------------------------------
# local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# --- WhatsApp Cloud API (oficial / Meta) ----------------------------------
# Painel: https://developers.facebook.com/apps -> WhatsApp -> Configuracao da API
WHATSAPP_CLOUD_ENABLED=false
# Token do app usado para validar a assinatura X-Hub-Signature-256 do webhook.
WHATSAPP_APP_SECRET=
# Voce escolhe este valor; o mesmo deve ser digitado no painel da Meta.
WHATSAPP_VERIFY_TOKEN=
# Token permanente do System User (nao use o token temporario de 24h).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_GRAPH_VERSION=v21.0

# --- WhatsApp nao-oficial (Evolution API / Baileys) - contingencia --------
EVOLUTION_ENABLED=false
EVOLUTION_PORT=8080
EVOLUTION_BASE_URL=http://localhost:8080
EVOLUTION_API_KEY=change-me-evolution-key
EVOLUTION_INSTANCE=central-pneus
# Segredo proprio que a Evolution devolve no header do webhook (validacao extra).
EVOLUTION_WEBHOOK_SECRET=

# --- IA (camada plugavel) -------------------------------------------------
# Escolha UM provedor. Os tres primeiros nao custam nada.
#
#   ollama      R$ 0   roda na sua maquina. Privado, offline, sem limite.
#   lmstudio    R$ 0   igual ao Ollama, porem com interface grafica.
#   groq        R$ 0*  nuvem, muito rapido. Camada gratuita com limite diario.
#   google      R$ 0*  nuvem (Gemini). Camada gratuita com limite por minuto.
#   openrouter  R$ 0*  nuvem. Gratuito somente em modelos terminados em ":free".
#   openai      pago
#   anthropic   pago
#   disabled    desliga a IA (toda conversa vai direto para a fila humana)
#
#   (*) Sem cartao de credito, mas com limite de uso.
AI_ENABLED=true
AI_PROVIDER=ollama

# --- Opcao 1: Ollama (recomendado - local e 100% gratuito) ----------------
# Instale em https://ollama.com e rode:  ollama pull qwen2.5:7b-instruct
# Maquina com pouca memoria? Use llama3.2:3b (cabe em 4 GB de RAM).
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_CHAT_MODEL=qwen2.5:7b-instruct
OLLAMA_ANALYSIS_MODEL=

# --- Opcao 2: LM Studio (local, com interface) ----------------------------
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_CHAT_MODEL=local-model

# --- Opcao 3: Groq (nuvem gratuita, chave em console.groq.com/keys) -------
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
GROQ_ANALYSIS_MODEL=

# --- Opcao 4: Google Gemini (gratuito em aistudio.google.com/apikey) ------
GOOGLE_API_KEY=
GOOGLE_CHAT_MODEL=gemini-2.0-flash
GOOGLE_ANALYSIS_MODEL=

# --- Opcao 5: OpenRouter (use modelos com sufixo :free) -------------------
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- Opcoes pagas (deixe em branco se nao for usar) -----------------------
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-opus-5
ANTHROPIC_ANALYSIS_MODEL=claude-opus-5
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_ANALYSIS_MODEL=gpt-4.1

AI_MAX_OUTPUT_TOKENS=800
AI_TEMPERATURE=0.4
# Depois de N respostas sem evoluir, a IA entrega para humano de qualquer jeito.
AI_MAX_TURNS_BEFORE_HANDOFF=12
# Teto de gasto mensal em USD. Irrelevante com provedor local (custo sempre 0).
AI_MONTHLY_BUDGET_USD=0

# --- Roteamento e SLA -----------------------------------------------------
# Minutos sem resposta do cliente ate a conversa ser marcada como ociosa.
IDLE_CONVERSATION_MINUTES=30
# Minutos ociosos ate encerrar automaticamente.
AUTO_CLOSE_MINUTES=180
# Segundos de SLA para a primeira resposta humana depois do handoff.
SLA_FIRST_RESPONSE_SECONDS=180
# Segundos que uma conversa pode ficar na fila antes de escalar para o admin.
QUEUE_ESCALATION_SECONDS=600
# Minutos de inatividade do atendente ate marca-lo como ausente automaticamente.
AGENT_AUTO_AWAY_MINUTES=10

# --- Limites de envio -----------------------------------------------------
# Mensagens por segundo por canal (a Meta permite bem mais, mas comece conservador).
CHANNEL_SEND_RATE_PER_SECOND=20
OUTBOX_SWEEP_INTERVAL_SECONDS=30

# --- Frontend -------------------------------------------------------------
WEB_PORT=8081
VITE_API_URL=http://localhost:3333

# --- Login com Google (Firebase Authentication) ---------------------------
# Backend: so o projectId e necessario. A verificacao do token usa as chaves
# publicas do Google - nao existe service account nem segredo aqui.
FIREBASE_PROJECT_ID=crm-central-3c633
# false = so entra quem o admin ja cadastrou (o Google substitui a senha).
# true  = qualquer conta Google vira atendente no primeiro acesso.
#         Use apenas em teste; em producao mantenha false.
GOOGLE_AUTO_PROVISION=false

# Frontend: estes valores sao PUBLICOS por design (vao no bundle). O que
# protege o projeto e a lista de dominios autorizados no console do Firebase,
# em Authentication > Settings > Authorized domains.
VITE_FIREBASE_API_KEY=AIzaSyBa0yDkJkcH5t3cPhrwtpCU_fqDrB7ZRbM
VITE_FIREBASE_AUTH_DOMAIN=crm-central-3c633.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=crm-central-3c633
VITE_FIREBASE_STORAGE_BUCKET=crm-central-3c633.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=729109532659
VITE_FIREBASE_APP_ID=1:729109532659:web:2c58fe5977f7ace25e0c86
