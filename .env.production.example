# =============================================================================
# CRM Central Pneus - configuracao de PRODUCAO
#
#   cp .env.production.example .env
#   ./scripts/gerar-segredos.sh        # preenche todos os TROCAR abaixo
#   nano .env                          # dominio, Firebase e chaves de IA
#
# FACA BACKUP DESTE ARQUIVO FORA DO SERVIDOR (gerenciador de senhas).
# Sem CREDENTIALS_ENCRYPTION_KEY, as credenciais dos canais de WhatsApp
# salvas no banco ficam ilegiveis - o backup do banco sozinho nao as recupera.
#
# DATABASE_URL, REDIS_URL, PUBLIC_API_URL e CORS_ORIGINS NAO vao aqui: o
# docker-compose.prod.yml monta a partir das variaveis abaixo.
# =============================================================================

# --- Endereco ----------------------------------------------------------------
# Subdominio que aponta (registro A) para o IP publico da VM.
DOMINIO=crm.suaempresa.com.br

# --- Segredos (gerados por scripts/gerar-segredos.sh) -------------------------
# Hex de proposito nas senhas: entram em URLs de conexao, onde "@", "/" e ":"
# quebrariam o endereco.
POSTGRES_USER=crm
POSTGRES_DB=crm
POSTGRES_PASSWORD=TROCAR
REDIS_PASSWORD=TROCAR
JWT_ACCESS_SECRET=TROCAR
JWT_REFRESH_SECRET=TROCAR
# 32 bytes em base64 - o formato e verificado na primeira vez que um canal e salvo.
CREDENTIALS_ENCRYPTION_KEY=TROCAR
EVOLUTION_API_KEY=TROCAR
EVOLUTION_WEBHOOK_SECRET=TROCAR

# --- Login com Google (Firebase) ----------------------------------------------
# Configuracao PUBLICA do app web (console do Firebase > Configuracoes do
# projeto > Seus apps). Entra no painel no momento do build da imagem.
# Adicione tambem o DOMINIO em Authentication > Settings > Authorized domains.
FIREBASE_PROJECT_ID=crm-central-3c633
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=crm-central-3c633.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=crm-central-3c633
VITE_FIREBASE_STORAGE_BUCKET=crm-central-3c633.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=729109532659
VITE_FIREBASE_APP_ID=1:729109532659:web:2c58fe5977f7ace25e0c86
# Quem nao estiver cadastrado nao entra, mesmo com conta Google valida.
GOOGLE_AUTO_PROVISION=false

# --- IA ------------------------------------------------------------------------
# A cadeia tenta na ordem e pula para o proximo quando um falha ou fica sem
# cota. Gratuito primeiro, pago como reserva.
#
# Ao atingir o teto mensal, o sistema NAO para de atender: ele passa a usar
# somente os provedores gratuitos e deixa de gastar. Se nenhum gratuito
# estiver disponivel, a conversa vai para um atendente humano.
# Zero desliga o teto.
AI_ENABLED=true
AI_PROVIDER=groq
AI_PROVIDER_CHAIN=groq,openai
GROQ_API_KEY=
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
AI_MONTHLY_BUDGET_USD=20

# --- WhatsApp via QR Code (Evolution) -----------------------------------------
EVOLUTION_ENABLED=true
EVOLUTION_INSTANCE=central-pneus

# --- Operacao ------------------------------------------------------------------
TZ=America/Sao_Paulo
LOG_LEVEL=info
