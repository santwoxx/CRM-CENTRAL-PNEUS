{
  "name": "crm-central-pneus",
  "version": "0.1.0",
  "private": true,
  "description": "CRM omnichannel com atendimento humano + IA sobre um unico numero de WhatsApp",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "packages/shared",
    "packages/api",
    "packages/web"
  ],
  "scripts": {
    "build": "npm run build -w @crm/shared && npm run build -w @crm/api && npm run build -w @crm/web",
    "dev": "concurrently -n api,worker,web -c blue,magenta,green \"npm:dev:api\" \"npm:dev:worker\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w @crm/api",
    "dev:worker": "npm run dev:worker -w @crm/api",
    "dev:web": "npm run dev -w @crm/web",
    "typecheck": "npm run typecheck -w @crm/shared && npm run typecheck -w @crm/api && npm run typecheck -w @crm/web",
    "lint": "eslint .",
    "test": "npm run test -w @crm/api",
    "db:generate": "prisma generate --schema packages/api/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema packages/api/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema packages/api/prisma/schema.prisma",
    "db:seed": "tsx packages/api/prisma/seed.ts",
    "db:studio": "prisma studio --schema packages/api/prisma/schema.prisma",
    "infra:up": "docker compose up -d postgres redis",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "setup": "npm install && npm run db:generate && npm run db:deploy && npm run db:seed",
    "db:push": "prisma db push --schema packages/api/prisma/schema.prisma"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "concurrently": "^9.1.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true,
    "esbuild@0.25.12": true,
    "msgpackr-extract@3.0.4": true,
    "prisma@6.19.3": true
  }
}
